      "summaryTitle": "Endgame Park Performance",
      "summaryDescription": "Loading zone park rate across matches",
      "stateKey": "endgame.ending_position",
      "breakdownKey": "endgame.robot_broke_down",
      "states": [
        { "value": "none", "label": "None", "points": 0 },
        { "value": "loading_zone", "label": "Loading Zone", "points": 5, "highlightThreshold": 80 }
      ]
    },
    "penalties": {
      "title": "Reliability & Penalties",
      "description": "Robot reliability and penalty averages",
